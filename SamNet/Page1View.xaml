 <UserControl x:Class="SamNet.Page1View"
             xmlns:local="clr-namespace:SamNet"
             xmlns:t="clr-namespace:SharedToolbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d">
     
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisConverter"/>
        <t:VisConverterInvisible x:Key="InvisConverter"/>
        <t:VisConverterAnd x:Key="AndVisibilityConverter"/>
        <t:VisConverterNot x:Key="NotVisibilityConverter"/>
        <t:VisConverterNotHidden x:Key="VisNotHiddenConverter"/>
        <t:VisConverterTrueFalse x:Key="TrueFalseVisibilityConverter"/>
        <t:VisConverterFalseFalse x:Key="FalseFalseVisibilityConverter"/>
        <t:VisConverterEqual x:Key="VisEqualConverter"/>
        <t:VisConverterFlag x:Key="VisFlagConverter"/>
        <t:BooleanNotConverter x:Key="NotConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1872*" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="53"/>
            <RowDefinition Height="900*"/>
            <RowDefinition Height="53"/>
        </Grid.RowDefinitions>

        <Grid Margin="2" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="842"/>
            </Grid.RowDefinitions>
            <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="150"/>
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                        <Setter Property="Background" Value="#F0F0F0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,1"
                                                CornerRadius="6,6,0,0" Margin="{TemplateBinding Margin}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Tab strip + extra content -->
                                <ColumnDefinition Width="*"/>
                                <!-- Content area -->
                            </Grid.ColumnDefinitions>

                            <!-- Left side: tabs + anything after the last tab -->
                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <StackPanel  Grid.Column="0"  Orientation="Vertical"  VerticalAlignment="Top">

                                    <!-- The actual tab headers -->
                                    <TabPanel IsItemsHost="True"  Margin="0,0,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Content presenter for the selected tab -->
                            <Border Grid.Column="1"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="Setup" FontSize="14" Tag="3DPoint">
                    <Grid Background="Transparent" Width="1600" Height="926">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="900"/>
                            <ColumnDefinition Width="690"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="840*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Style="{StaticResource EnabledDisabledStackPanel}" IsEnabled="{Binding IsSetupSamEnabled}" >
                                <GroupBox Header="Create dataset with Sam from an existing image" Margin="10,5,5,5" FontSize="20" Foreground="Blue">
                                    <StackPanel Width="890" Height="580" Margin="20" >
                                        <StackPanel HorizontalAlignment="Left">
                                            <StackPanel HorizontalAlignment="Left">
                                                <StackPanel Height="80" Visibility="{Binding IsSetupImageButtonShowing, Converter={StaticResource VisConverter}}" >
                                                    <Button Height="67" Width="140" Margin="0,12,0,0" Tag="SelectImage" Foreground="Green">
                                                        <TextBlock TextAlignment="Center" FontSize="20">Select<LineBreak/>Image</TextBlock>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="PreviewMouseDown">
                                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Height="80" Visibility="{Binding IsSetupImageButtonShowing, Converter={StaticResource NotVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Margin="10,20,0,0">
                                                        <TextBlock Text="Image Selected:" FontSize="22"  Foreground="Black"/>
                                                        <TextBlock Text="{Binding ImageShortName}" FontSize="22"  Margin="30,0,0,0" Foreground="Black"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel.Visibility>
                                                    <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                        <Binding Source="1"/>
                                                        <Binding Path="SetupItemState"/>
                                                    </MultiBinding>
                                                </StackPanel.Visibility>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Left">
                                                <StackPanel Height="80" Visibility="{Binding IsSetupModelButtonShowing, Converter={StaticResource VisConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Height="67" Width="140" Margin="0,12,0,0" Tag="SelectGGML" Foreground="Green"  >
                                                            <TextBlock TextAlignment="Center" FontSize="20">Select<LineBreak/>Sam Model</TextBlock>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="PreviewMouseDown">
                                                                    <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Height="80" Visibility="{Binding IsSetupModelButtonShowing, Converter={StaticResource NotVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Margin="10,20,0,0">
                                                        <TextBlock Text="Model Selected:" FontSize="22"  Foreground="Black"/>
                                                        <TextBlock Text="{Binding ModelMessage}" FontSize="22"  Margin="30,0,0,0" Foreground="Black"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel.Visibility>
                                                    <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                        <Binding Source="2"/>
                                                        <Binding Path="SetupItemState"/>
                                                    </MultiBinding>
                                                </StackPanel.Visibility>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Left">
                                                <StackPanel Height="80" Visibility="{Binding IsSetupEncodeButtonShowing, Converter={StaticResource VisConverter}}" >
                                                    <Button Height="67" Width="140" Margin="0,12,0,0" Tag="Encode" Foreground="Green"  >
                                                        <TextBlock TextAlignment="Center" FontSize="20">Encode<LineBreak/>Image</TextBlock>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="PreviewMouseDown">
                                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Height="80" Visibility="{Binding IsSetupEncodeButtonShowing, Converter={StaticResource NotVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Margin="10,20,0,0">
                                                        <TextBlock Text="{Binding EncodingStatusMessage}" FontSize="22"  Foreground="Black"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel.Visibility>
                                                    <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                        <Binding Source="4"/>
                                                        <Binding Path="SetupItemState"/>
                                                    </MultiBinding>
                                                </StackPanel.Visibility>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                            <StackPanel Style="{StaticResource EnabledDisabledStackPanel}" IsEnabled="{Binding IsUIEnabled}" >
                                <StackPanel Orientation="Horizontal">
                                    <GroupBox Header="Clear work and select new image, model or import" Margin="10,1,5,5" 
                                        FontSize="20" Foreground="Blue">
                                        <StackPanel Width="480" Height="72" Margin="20">
                                            <StackPanel HorizontalAlignment="Center" >
                                                <Button Height="67" Width="250" Margin="0,2,0,0" Tag="CleanRestart" Foreground="Red">
                                                    <TextBlock TextAlignment="Center" FontSize="18">Clean All And Start Over</TextBlock>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="PreviewMouseDown">
                                                            <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Manual Segmentation" Margin="10,1,5,5" FontSize="20" Foreground="Blue">
                                        <StackPanel Width="286" Height="72" Margin="20">
                                            <StackPanel HorizontalAlignment="Center" >
                                                <Button Height="67" Width="220" Margin="0,2,0,0" Tag="ManualSegmentation" Foreground="Green"  >
                                                    <TextBlock TextAlignment="Center" FontSize="20">Perform Manual<LineBreak/>Segmentation</TextBlock>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="PreviewMouseDown">
                                                            <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                            <Binding Source="6"/>
                                                            <Binding Path="SetupItemState"/>
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                                

                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource EnabledDisabledStackPanel}" IsEnabled="{Binding IsSetupImportEnabled}" >
                            <GroupBox Header="Import from existing dataset" Margin="10,5,5,5" FontSize="20" Foreground="Blue" >
                                <StackPanel Width="680" Height="730" Margin="20">
                                    <StackPanel Margin="0,0,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,0,0" HorizontalAlignment="Left" Width="500">
                                                <TextBlock TextAlignment="Left" FontSize="24" Foreground="Black">Import From:</TextBlock>
                                                <ListBox ItemsSource="{Binding ExportFolders}" SelectedItem="{Binding SelectedExportFolder}" Style="{StaticResource RadioButtonListBoxExportFolder}" 
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"  FontSize="15" Margin="0,6,0,0" >
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:CallMethodAction TargetObject="{Binding}" MethodName="ExportFolderSelectionChanged"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel>
                                                <Button Height="67" Width="120" Margin="0,32,0,0" Tag="Import" Foreground="Green" 
                                                        Visibility="{Binding IsShowImportButton, Converter={StaticResource VisConverter}}">
                                                    <TextBlock TextAlignment="Center" FontSize="20">Import<LineBreak/>Json</TextBlock>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="PreviewMouseDown">
                                                            <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>                   
                        <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="1"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <TabItem Header="Sam" FontSize="14" Tag="Sam">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1326"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Canvas Background="#A0A0A0" Grid.Row="0" Grid.Column="0" Width="{Binding BS_CanvasWidth}" 
                        Height="{Binding BS_CanvasHeight}" ClipToBounds="True">
                            <Image Source="{Binding BS}" Canvas.Left="{Binding BS_Left}" Canvas.Top="{Binding BS_Top}" Panel.ZIndex="1"
                           Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Width="{Binding BS_Width}" Height="{Binding BS_Height}">
                            </Image>                            
                            <Canvas Canvas.Left="{Binding BS_Left}" Canvas.Top="{Binding BS_Top}" Width="{Binding BS_Width}" Height="{Binding BS_Height}" Background="Transparent" 
                            Panel.ZIndex="2" >
                                <ItemsControl ItemsSource="{Binding SamPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>                                            <Grid>
                                                <Line X1="{Binding Ax1}" Y1="{Binding Ay1}" X2="{Binding Ax2}" Y2="{Binding Ay2}" Stroke="{Binding Color}" StrokeThickness="2" />
                                                <Line X1="{Binding Bx1}" Y1="{Binding By1}" X2="{Binding Bx2}" Y2="{Binding By2}" Stroke="{Binding Color}" StrokeThickness="2" />
                                         
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding SamRectangles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="Transparent"  
                                                       Stroke="{Binding Color}" StrokeDashArray="{Binding Dash}" StrokeThickness="1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseDown">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseDown"/>
                                    </i:EventTrigger>
                                    <!--
                                    <i:EventTrigger EventName="PreviewMouseRightButtonDown">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="PanMouseRightButtonDown"/>
                                    </i:EventTrigger>
                                    -->
                                    <i:EventTrigger EventName="PreviewMouseUp">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseUp"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseMove">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseMove"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseLeave">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseLeave"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Canvas>
                            
                        </Canvas>
                        <StackPanel Grid.Column="1" IsEnabled="{Binding IsSamInProgress, Converter={StaticResource NotConverter}}"
                                                Style="{StaticResource EnabledDisabledStackPanel}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <StackPanel Width="100" Margin="36,16,0,0">
                                    <RadioButton GroupName="SamMode" Name="Sam2Radio"  Tag="Sam2PVS" 
                                                 IsChecked="{Binding Is_RB_Sam2PVS_Checked}">
                                        <TextBlock Text=" PVS" FontSize="24" Margin="0,-10,0,0"/>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Checked">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </RadioButton>
                                </StackPanel>
                                <StackPanel Width="100" Margin="20,16,0,0">
                                    <RadioButton GroupName="SamMode" Name="Sam3Radio"  Tag="Sam3PCS" IsChecked="{Binding Is_RB_Sam3PCS_Checked}"
                                                 IsEnabled="{Binding IsSam3Enabled}" Foreground="{Binding Sam3RadioBrush}" >
                                        <TextBlock Text=" PCS" FontSize="24" Margin="0,-10,0,0"/>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Checked">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Height="720">
                                <StackPanel Tag="Sam2Panel" Visibility="{Binding IsChecked, ElementName=Sam2Radio, Converter={StaticResource VisConverter}}">
                                    <GroupBox Header="Sam2 Mode" Margin="10,5,5,5" FontSize="14">
                                        <StackPanel >
                                            <RadioButton GroupName="Sam2Buttons"  Foreground="Black" Margin="6,8,0,0" Tag="Sam2Single"
                                                         IsChecked="{Binding Is_RB_Sam2Single_Checked}">
                                                <TextBlock Text="Single Object" FontSize="18" Margin="0,-8,0,0"/>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="Sam2Buttons"  Foreground="Black" Margin="6,8,0,0" Tag="Sam2MultiMask"
                                                         IsChecked="{Binding Is_RB_Sam2MultiMask_Checked}">
                                                <TextBlock Text="Single Object MultiMask" FontSize="18" Margin="0,-8,0,0"/>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="Sam2Buttons"  Foreground="Black" Margin="6,8,0,0" Tag="Sam2Multiple"
                                                         IsChecked="{Binding Is_RB_Sam2Multiple_Checked}">
                                                <TextBlock Text="Multiple Objects" FontSize="18" Margin="0,-8,0,0"/>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </RadioButton>
                                        </StackPanel>
                                    </GroupBox>
                                    <StackPanel Tag="Sam2Single">
                                        <TextBlock Text="Left Click - Positive Point(s)" FontSize="16" Margin="16,4,0,0" Foreground="Green"/>
                                        <TextBlock Text="Right Click - Negative Point(s)" FontSize="16" Margin="16,4,0,0" Foreground="Red"/>
                                        <TextBlock Text="Left Drag - Region of Interest(1)" FontSize="16" Margin="16,4,0,0" Foreground="Blue"/>
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                <Binding Source="1"/>
                                                <Binding Path="RightColumnState"/>
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                    </StackPanel>
                                    <StackPanel Tag="Sam2MultiMask">
                                        <TextBlock Text="Left Click - Positive Point(1)" FontSize="16" Margin="16,4,0,0" Foreground="Green"/>
                                        <TextBlock Text="Right Click - Negative Point(s)" FontSize="16" Margin="16,4,0,0" Foreground="Red"/>
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                <Binding Source="2"/>
                                                <Binding Path="RightColumnState"/>
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                    </StackPanel>
                                    <StackPanel Tag="Sam2Multiple">
                                        <TextBlock Text="Left Drag - Region(s) of Interest" FontSize="16" Margin="16,4,0,0" Foreground="Blue"/>
                                        <TextBlock Text="Left Click - Positive Point(s)" FontSize="16" Margin="16,4,0,0" Foreground="Green"/>
                                        <TextBlock Text="Pos points outside boxes ignored" FontSize="16" Margin="16,4,0,0" Foreground="Green"/>
                                        <TextBlock Text="Right Click - Negative Point(s)" FontSize="16" Margin="16,4,0,0" Foreground="Red"/>
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                <Binding Source="4"/>
                                                <Binding Path="RightColumnState"/>
                                            </MultiBinding>
                                        </StackPanel.Visibility>

                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsRunButtonAllowed, Converter={StaticResource VisConverter}}">
                                        <Button Grid.Column="0" Height="67" Width="140" Margin="0,32,0,0" Tag="Sam2Point" Foreground="Green" 
                                                Visibility="{Binding IsClickListPopulated, Converter={StaticResource VisConverter}}">
                                            <TextBlock TextAlignment="Center" FontSize="20">Run<LineBreak/>Sam2</TextBlock>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseDown">
                                                    <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Tag="Sam3Panel" Visibility="{Binding IsChecked, ElementName=Sam3Radio, Converter={StaticResource VisConverter}}" >
                                    <StackPanel Orientation="Vertical" >
                                        <TextBlock Text="Text Prompt - Describe Object" FontSize="16" Margin="6,4,0,0" Foreground="Blue"/>
                                        <TextBlock Text="Left Drag - Positive Region(s) (Opt)" FontSize="16" Margin="6,4,0,0" Foreground="Green"/>
                                        <TextBlock Text="Right Drag - Negative Region(s) (Opt)" FontSize="16" Margin="6,4,0,0" Foreground="Red"/>
                                        <TextBlock Text="TextPrompt" Style="{StaticResource BlackTextBlock20}" Height="32" Width="240" 
                                            TextAlignment="Center" Margin="0,20,0,0" Padding="0,6,0,0"/>
                                        <TextBox Text="{Binding TextPrompt}" Margin="5,10,5,5" FontSize="18" Width="250" Height="32" Tag="TextPrompt">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="TextChanged">
                                                    <i:CallMethodAction TargetObject="{Binding}" MethodName="TextChange"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <TextBlock Text="Confidence" Style="{StaticResource BlackTextBlock20}" Height="32" Width="240" 
                                            TextAlignment="Center" Margin="0,8,0,0" Padding="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                            <Slider  Style="{StaticResource ModernSliderStyle}" Tag="ScoreSlider" Minimum="0" Maximum="1"
                                                 TickFrequency=".02" Value="{Binding ConfidenceValue, Mode=TwoWay}" Width="200" Height="34" Margin="5" Foreground="Red">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseUp">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="SliderUp"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Slider>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding ConfidenceValue, StringFormat=F2}" Margin="5" Height="34" Width="56" FontSize="20" 
                                                           TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Margin="8,10,0,0">
                                        <TextBlock Text="Overlap Filter" Style="{StaticResource BlackTextBlock20}" Height="32" Width="240" 
                                                TextAlignment="Center" Margin="0,0,0,0" Padding="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider  Style="{StaticResource ModernSliderStyle}" Tag="OverlapSlider" Minimum="0" Maximum="1"
             TickFrequency=".02" Value="{Binding OverlapValue, Mode=TwoWay}" Width="200" Height="34" Margin="5" Foreground="Red">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseUp">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="SliderUp"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Slider>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding OverlapValue, StringFormat=F2}" Margin="5" Height="34" Width="56" FontSize="20" 
                       TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsRunButtonAllowed, Converter={StaticResource VisConverter}}">
                                        <Button Grid.Column="0" Height="67" Width="140" Margin="0,18,0,0" Tag="Sam3Prompt" Foreground="Green" 
                                            Visibility="{Binding IsTextBoxReady, Converter={StaticResource VisConverter}}">
