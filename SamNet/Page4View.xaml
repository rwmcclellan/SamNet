<UserControl x:Class="SamNet.Page4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SamNet"             
             xmlns:t="clr-namespace:SharedToolbox"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisConverter"/>
        <t:VisConverterInvisible x:Key="InvisConverter"/>
        <t:VisConverterAnd x:Key="AndVisibilityConverter"/>
        <t:VisConverterNot x:Key="NotVisibilityConverter"/>
        <t:VisConverterNotHidden x:Key="VisNotHiddenConverter"/>
        <t:VisConverterTrueFalse x:Key="TrueFalseVisibilityConverter"/>
        <t:VisConverterFalseFalse x:Key="FalseFalseVisibilityConverter"/>
        <t:VisConverterEqual x:Key="VisEqualConverter"/>
        <t:VisConverterFlag x:Key="VisFlagConverter"/>
        <t:BooleanNotConverter x:Key="NotConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1872*" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="53"/>
            <RowDefinition Height="900*"/>
            <RowDefinition Height="53"/>
        </Grid.RowDefinitions>

        <Grid Margin="2" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="842"/>
            </Grid.RowDefinitions>
            <StackPanel>
                
                
            </StackPanel>
            <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="90"/>
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                        <Setter Property="Background" Value="#F0F0F0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,1"
                                                CornerRadius="6,6,0,0" Margin="{TemplateBinding Margin}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Tab strip + extra content -->
                                <ColumnDefinition Width="*"/>
                                <!-- Content area -->
                            </Grid.ColumnDefinitions>

                            <!-- Left side: tabs + anything after the last tab -->
                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <StackPanel  Grid.Column="0"  Orientation="Vertical"  VerticalAlignment="Top">

                                    <!-- The actual tab headers -->
                                    <TabPanel IsItemsHost="True"  Margin="0,0,0,0"/>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,370,0,0"
                                                Visibility="{Binding IsRoiCanvasShowing, Converter={StaticResource VisConverter}}">
                                    </StackPanel>  
                                </StackPanel>
                            </DockPanel>                           

                            <!-- Content presenter for the selected tab -->
                            <Border Grid.Column="1"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
				<TabItem Header="Event Log" FontSize="14" Tag="Console">
					<Grid Background="Transparent">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1686"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<StackPanel Grid.Column="0">
							<ItemsControl ItemsSource="{Binding LogSnippets}" >
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid Margin="4">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="240" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="{Binding Time}"
                                                       Style="{StaticResource LogTimeCallerStyle}"/>
											<TextBlock Grid.Column="1" Text="{Binding Caller}"
                                                       Style="{StaticResource LogTimeCallerStyle}" />
											<TextBlock Grid.Column="2" Text="{Binding Message}"
                                                       Style="{StaticResource LogMessageStyle}"/>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Grid>
					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource VisFlagConverter}">
							<Binding Source="32"/>
							<Binding Path="TabItemState"/>
						</MultiBinding>
					</TabItem.Visibility>
				</TabItem>

				<TabItem Header="Close" FontSize="14" Tag="SamSetup">
                    <Grid Background="Transparent" Width="1600" Height="926">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="930"/>
                        </Grid.RowDefinitions>
                    </Grid>
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="1"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <TabItem Header="Close" FontSize="14" Tag="Edit">
                    <Grid Background="Transparent">
                    </Grid>
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="2"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <TabItem Header="Close" FontSize="14" Tag="DataSet">
                    <Grid Background="Transparent">
                    </Grid>
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="4"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:CallMethodAction TargetObject="{Binding}" MethodName="TabControlChanged"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
            <StackPanel Margin="160,0,0,0" Width="960" Height="40">
                <TextBlock Text = "{Binding UserMessage}" FontSize="20" />
            </StackPanel>
            <StackPanel Width="30" Height="40">
            </StackPanel>
            <StackPanel Width="600" Height="40" Orientation="Horizontal" FlowDirection="RightToLeft">
                <TextBlock Text = "{Binding ReviewStatusMessage}" FontSize="20" Foreground="{Binding ReviewStatusColor}"/>
                <TextBlock Text = " - " FontSize="20" TextAlignment="Right"/>
                <TextBlock Text = "{Binding ReviewMessage}" FontSize="20" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>