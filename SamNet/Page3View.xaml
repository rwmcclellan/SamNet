<UserControl x:Class="SamNet.Page3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SamNet"             
             xmlns:t="clr-namespace:SharedToolbox"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisConverter"/>
        <t:VisConverterInvisible x:Key="InvisConverter"/>
        <t:VisConverterAnd x:Key="AndVisibilityConverter"/>
        <t:VisConverterNot x:Key="NotVisibilityConverter"/>
        <t:VisConverterNotHidden x:Key="VisNotHiddenConverter"/>
        <t:VisConverterTrueFalse x:Key="TrueFalseVisibilityConverter"/>
        <t:VisConverterFalseFalse x:Key="FalseFalseVisibilityConverter"/>
        <t:VisConverterEqual x:Key="VisEqualConverter"/>
        <t:VisConverterFlag x:Key="VisFlagConverter"/>
        <t:BooleanConverterEqual x:Key="BoolEqualConverter"/>
        <t:BooleanConverterFlag x:Key="BoolFlagConverter"/>
        <t:BooleanNotConverter x:Key="NotConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1872*" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="53"/>
            <RowDefinition Height="900*"/>
            <RowDefinition Height="53"/>
        </Grid.RowDefinitions>

        <Grid Margin="2" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="842"/>
            </Grid.RowDefinitions>
            <StackPanel>
                
            </StackPanel>
            <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="90"/>
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                        <Setter Property="Background" Value="#F0F0F0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,1"
                                                CornerRadius="6,6,0,0" Margin="{TemplateBinding Margin}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Tab strip + extra content -->
                                <ColumnDefinition Width="*"/>
                                <!-- Content area -->
                            </Grid.ColumnDefinitions>

                            <!-- Left side: tabs + anything after the last tab -->
                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <StackPanel  Grid.Column="0"  Orientation="Vertical"  VerticalAlignment="Top">

                                    <!-- The actual tab headers -->
                                    <TabPanel IsItemsHost="True"  Margin="0,0,0,0"/>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,370,0,0">
                                    </StackPanel>  
                                </StackPanel>
                            </DockPanel>                           

                            <!-- Content presenter for the selected tab -->
                            <Border Grid.Column="1"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="DataSet" FontSize="14" Tag="DataSet">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="1326"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Height="668">
                                <GroupBox Header="Main Labels" Margin="2,5,2,5" FontSize="16" Height="660">
                                    <ListBox ItemsSource="{Binding Mains}" SelectedItem="{Binding CurrentMainLabel}"
                                             Style="{StaticResource RadioButtonListBox}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"  Height="620" FontSize="15" Margin="0,6,0,0">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="MainLabelSelectionChanged"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ListBox>
                                </GroupBox>
                            </StackPanel>
                            <StackPanel Height="180" >
                                <GroupBox Header="Edit Main Labels" Margin="2,1,2,1" FontSize="16" >
                                    <StackPanel Height="140">
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <RadioButton GroupName="MainEdit"  Foreground="Black" Margin="6,8,0,0" Tag="MainName"  IsChecked="True" >
                                                <TextBlock Text="Name" FontSize="18" Margin="0,-5,0,0" />
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="MainEdit"  Foreground="Black" Margin="12,8,0,0" Tag="MainDelete">
                                                <TextBlock Text="Delete" FontSize="18" Margin="0,-5,0,0"/>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </RadioButton>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsEditMainName, Converter={StaticResource VisConverter}}" Margin="0,6,0,0">
                                            <TextBlock TextAlignment="Left" FontSize="16" Margin="10,6,0,0" Text="{Binding CurrentMainLabel}"/>
                                            <TextBox Text="{Binding MainLabel, Mode=OneWay}" Height="28" VerticalContentAlignment="Center" Margin="10,4,10,0">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="TextChanged">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="TextBoxChangedMainLabel"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Button Grid.Column="0" Height="34" Width="140" Margin="0,4,0,0" Tag="ChangeMainLabel" Foreground="Green"
                                                    Visibility="{Binding IsShowMainLabelButton, Converter={StaticResource VisConverter}}">
                                                <TextBlock TextAlignment="Center" FontSize="14">Change Label</TextBlock>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseDown">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Margin="0,4,0,0" Visibility="{Binding IsEditMainName, Converter={StaticResource NotVisibilityConverter}}">
                                            <TextBlock TextAlignment="Left" FontSize="16" Margin="10,2,0,0" Text="{Binding CurrentMainLabel}"/>
                                            <Button Grid.Column="0" Height="68" Width="140" Margin="0,4,0,0" Tag="DeleteMainLabel" Foreground="Red">
                                                <TextBlock TextAlignment="Center" FontSize="16">Remove<LineBreak/>MainLabel +<LineBreak/>Children</TextBlock>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseDown">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Height="668">
                                <GroupBox Header="Sub Labels" Margin="2,5,2,5" FontSize="16" Height="660">
                                    <ListBox ItemsSource="{Binding Subs}" SelectedIndex="{Binding SelectedSubIndex}" Style="{StaticResource RadioButtonListBoxSubLabel}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"  Height="620" FontSize="15" Margin="0,6,0,0">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="SubLabelSelectionChanged"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ListBox>
                                </GroupBox>
                            </StackPanel>
                            <StackPanel Height="180" >
                                <GroupBox Header="Edit Sub Labels" Margin="2,1,2,1" FontSize="16" >
                                    <StackPanel Height="140">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="SubEdit"  Foreground="Black" Margin="6,8,0,0" Tag="SubName"  IsChecked="True" >
                                                <TextBlock Text="Name" FontSize="18" Margin="0,-5,0,0" />
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="SubEdit"  Foreground="Black" Margin="12,8,0,0" Tag="SubDelete">
                                                <TextBlock Text="Delete" FontSize="18" Margin="0,-5,0,0"/>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </RadioButton>
                                        </StackPanel>
                                        <RadioButton GroupName="SubEdit"  Foreground="Black" Margin="12,2,0,0" Tag="SubParent">
                                            <TextBlock Text="Change Parent" FontSize="18" Margin="0,-5,0,0"/>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Checked">
                                                    <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </RadioButton>
                                        <StackPanel Name="SubLabel" Margin="0,2,0,0" Tag="ChangeSubLabel">
                                            <TextBlock TextAlignment="Left" FontSize="16" Margin="10,0,0,0" Text="{Binding CurrentSubLabel}"/>
                                            <TextBox Text="{Binding SubLabel, Mode=OneWay}" Height="28" VerticalContentAlignment="Center" Margin="10,4,10,0">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="TextChanged">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="TextBoxChangedSubLabel"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Button Grid.Column="0" Height="34" Width="140" Margin="0,4,0,0" Tag="ChangeSubLabel" Foreground="Green"
                                                Visibility="{Binding IsShowSubLabelButton, Converter={StaticResource VisConverter}}">
                                                <TextBlock TextAlignment="Center" FontSize="14">Change SubLabel</TextBlock>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseDown">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Button>
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                    <Binding Source="1"/>
                                                    <Binding Path="EditSubLabelState"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>
                                        </StackPanel>
                                        <StackPanel Name="DeleteSub" Margin="0,2,0,0" Tag="DeleteSubLabel">
                                            <TextBlock TextAlignment="Left" FontSize="16" Margin="10,4,0,0" Text="{Binding CurrentSubLabel}"/>
                                           <Button Grid.Column="0" Height="54" Width="140" Margin="0,6,0,0" Tag="DeleteSubLabel" Foreground="Red">
                                                <TextBlock TextAlignment="Center" FontSize="16">Remove<LineBreak/>SubLabel</TextBlock>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseDown">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Button>
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                    <Binding Source="2"/>
                                                    <Binding Path="EditSubLabelState"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>
                                        </StackPanel>
                                        <StackPanel Name="SubRemoveParent" Margin="0,2,0,0" Tag="SubRemoveParent">
                                            <TextBlock TextAlignment="Left" FontSize="16" Margin="10,0,0,0" Text="{Binding CurrentMainLabel}"/>
                                            <TextBox Text="{Binding SubLabel, Mode=OneWay}" Height="28" VerticalContentAlignment="Center" Margin="10,4,10,0">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="TextChanged">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="TextBoxChangedSubLabel"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Button Grid.Column="0" Height="34" Width="140" Margin="0,4,0,0" Tag="ChangeParentLabel" Foreground="Green"
                                                Visibility="{Binding IsShowSubLabelButton, Converter={StaticResource VisConverter}}">
                                                <TextBlock TextAlignment="Center" FontSize="14">Change Parent Label</TextBlock>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseDown">
                                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Button>
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource VisFlagConverter}">
                                                    <Binding Source="4"/>
                                                    <Binding Path="EditSubLabelState"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>
                                        </StackPanel>
                                    </StackPanel>
                            </GroupBox>
                            </StackPanel>
                        </StackPanel>
                        <Canvas Background="#A0A0A0" Grid.Row="0" Grid.Column="2" Width="{Binding BS_CanvasWidth}" Height="{Binding BS_CanvasHeight}"
                            ClipToBounds="True" > 
                            <Image Source="{Binding BS}" Canvas.Left="{Binding BS_Left}" Canvas.Top="{Binding BS_Top}" Panel.ZIndex="1"
                           Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Width="{Binding BS_Width}" Height="{Binding BS_Height}">
                            </Image>
                            <Image Source="{Binding BS_Three}" Canvas.Left="{Binding BS_Three_Left}" Canvas.Top="{Binding BS_Three_Top}" Panel.ZIndex="2"
                            Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Width="{Binding BS_Three_Width}" Height="{Binding BS_Three_Height}">
                            </Image>
                        </Canvas>
                        <Canvas Background="Transparent"  Grid.Row="0" Grid.Column="2" Width="{Binding BS_CanvasWidth}" Height="{Binding BS_CanvasHeight}"
                            ClipToBounds="True" >
                            <Image Source="{Binding BS_Roi}" Canvas.Left="{Binding BS_Roi_Left}" Canvas.Top="{Binding BS_Roi_Top}" Panel.ZIndex="1"
                           Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Width="{Binding BS_Roi_Width}" Height="{Binding BS_Roi_Height}">
                            </Image>
                            <Canvas Canvas.Left="{Binding BS_Roi_Left}" Canvas.Top="{Binding BS_Roi_Top}" Width="{Binding BS_Roi_Width}" Height="{Binding BS_Roi_Height}" Background="Transparent" 
                            Panel.ZIndex="2" >
                                <!--
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Color}" StrokeThickness="3" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                -->
                               <i:Interaction.Triggers>
                                    <!--
                                    <i:EventTrigger EventName="PreviewMouseDown">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseDown"/>
                                    </i:EventTrigger>
                                   
                                    <i:EventTrigger EventName="PreviewMouseRightButtonDown">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="PanMouseRightButtonDown"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseUp">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseUp"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseMove">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseMove"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseLeave">
                                        <i:CallMethodAction TargetObject="{Binding}" MethodName="ImageMouseLeave"/>
                                    </i:EventTrigger>
                                   
                                    -->
                                </i:Interaction.Triggers>
                            </Canvas>
                        </Canvas>

                    </Grid>
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="1"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <TabItem Header="Edit" FontSize="14" Tag="Edit">
                    <Grid Background="Transparent" Width="1600" Height="926">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="930"/>
                        </Grid.RowDefinitions>
                    </Grid>
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="2"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <TabItem Header="New Sam" FontSize="14" Tag="NewSam">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1686"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    </Grid>
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="4"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <TabItem Header="Export" FontSize="14" Tag="Export">
                    <Grid Background="Transparent">
                        <StackPanel>
                            <StackPanel Margin="30,20,0,20" HorizontalAlignment="Center">
                                <TextBlock Text = "All exports are currently 1 image with 1 json containing multiple instances" FontSize="20" />
                                <TextBlock Text = "Future TODO - Multiple images with 1 merged json." FontSize="20" />
                            </StackPanel>
                            <StackPanel Margin="100,20,0,20" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                                    <TextBlock Text = "Coco Export Root Folder:" FontSize="20" Width="300"/>
                                    <TextBlock Text = "{Binding ExportFolder}" FontSize="20" Width="300"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                                    <TextBlock Text = "Coco Export Name:" FontSize="20" Width="300"/>
                                    <TextBox Text="{Binding ExportName, Mode=OneWay}" Height="40" Width="200" FontSize="18" VerticalContentAlignment="Center">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="TextBoxChangedExport"/>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="GotFocus">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="TextBoxGotFocusExport"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,30,0,0"
                                            Visibility="{Binding IsExportPathAvailable, Converter={StaticResource NotVisibilityConverter}}">
                                    <TextBlock Text = "Coco path not empty:" FontSize="20" Width="300" Margin="0,20,0,0" Foreground="Red"/>                                    
                                    <TextBlock Text = "{Binding ExportPath}" FontSize="20" Width="400" Margin="0,20,0,0" Foreground="Red"/>
                                    <Button Grid.Column="0" Height="60" Width="130" Margin="0,0,0,0" Tag="Overwrite" Foreground="Red"
                                            Visibility="{Binding IsExportButtonShowing, Converter={StaticResource VisConverter}}">
                                        <TextBlock TextAlignment="Center" FontSize="20">Overwrite<LineBreak/>DataSet</TextBlock>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="PreviewMouseDown">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Button>
                                    <TextBlock Text = "Folder does not exist" FontSize="20" Width="200" Margin="0,20,0,0" Foreground="Red"
                                                   Visibility="{Binding IsExportButtonShowing, Converter={StaticResource NotVisibilityConverter}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,30,0,0"
                                            Visibility="{Binding IsExportPathAvailable, Converter={StaticResource VisConverter}}">
                                    <Button Grid.Column="0" Height="60" Width="130" Margin="0,18,0,0" Tag="Export" Foreground="Green"
                                           Visibility="{Binding IsExportButtonShowing, Converter={StaticResource VisConverter}}">
                                        <TextBlock TextAlignment="Center" FontSize="20">Export<LineBreak/>DataSet</TextBlock>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="PreviewMouseDown">
                                                <i:CallMethodAction TargetObject="{Binding}" MethodName="ButtonPressed"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>                       
                    </Grid>                    
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="8"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <TabItem Header="Event Log" FontSize="14" Tag="Console">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1686"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    </Grid>
                    <TabItem.Visibility>
                        <MultiBinding Converter="{StaticResource VisFlagConverter}">
                            <Binding Source="32"/>
                            <Binding Path="TabItemState"/>
                        </MultiBinding>
                    </TabItem.Visibility>
                </TabItem>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:CallMethodAction TargetObject="{Binding}" MethodName="TabControlChanged"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
            <StackPanel Margin="160,0,0,0" Width="1100" Height="40">
                <TextBlock Text = "{Binding UserMessage}" FontSize="20" />
            </StackPanel>
            <StackPanel Width="30" Height="40">
            </StackPanel>
            <StackPanel Width="600" Height="40" >                
                <StackPanel Name="RadioPanel" Orientation="Horizontal" >
                    <RadioButton GroupName="RBMaskView"  Foreground="Black" Margin="00,5,0,0" Tag="1" >
                        <TextBlock Text="Full Mask" FontSize="22" Margin="0,-8,0,0"/>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource BoolEqualConverter}" Mode="OneWay" >
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" Mode="OneWay"/>
                                <Binding Path="RBMaskViewState" Mode="OneWay"/>
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton GroupName="RBMaskView"  Foreground="Black" Margin="30,5,0,0" Tag="2" >
                        <TextBlock Text="Original" FontSize="22" Margin="0,-8,0,0"  />
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource BoolEqualConverter}" Mode="OneWay" >
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" Mode="OneWay"/>
                                <Binding Path="RBMaskViewState" Mode="OneWay"/>
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton GroupName="RBMaskView"  Foreground="Black" Margin="30,5,0,0" Tag="3">
                        <TextBlock Text="Overlayed Mask" FontSize="22" Margin="0,-8,0,0"/>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:CallMethodAction TargetObject="{Binding}" MethodName="RadioButtonChecked"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource BoolEqualConverter}" Mode="OneWay" >
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" Mode="OneWay"/>
                                <Binding Path="RBMaskViewState" Mode="OneWay"/>
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource VisEqualConverter}">
                            <Binding Source="0"/>
                            <Binding Path="SelectedTabIndex"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                </StackPanel>
                
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>